# Environment Variables & Secrets (NEVER COMMIT SECRETS)
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Byte-compiled / optimized / cache
__pycache__/
**/__pycache__/
*.py[cod]
.cache/
**/.cache/

